  "quests": [
    {
      "id": "first_steps",
      "title": "Your first steps",
      "giver": "guide",
      "turnIn": "guide",
      "kind": "explore",
      "target": "practice-marker",
      "count": 1,
      "xp": 100,
      "gold": 5,
      "minLevel": 1,
      "requires": [],
      "location": {
        "x": 0,
        "z": -8
      },
      "radius": 4,
      "text": "Welcome! Walk to the blue marker north of here, then return to me. Move with WASD; click a person to interact.",
      "objective": "Visit the blue practice marker",
      "complete": "You found your way. Try a creature encounter or gather some herbs next.",
      "rewardCount": 1
    },
    {
      "id": "practice_fight",
      "title": "A little practice",
      "giver": "guide",
      "turnIn": "guide",
      "kind": "kill",
      "target": "slime",
      "count": 2,
      "xp": 100,
      "gold": 8,
      "minLevel": 2,
      "requires": [
        "first_steps"
      ],
      "reward": "practice_blade",
      "text": "Defeat two practice slimes in the northern field. Click one, then use Attack or press 1 to strike.",
      "objective": "Defeat practice slimes",
      "complete": "Well done. Here is an improved practice blade. Your world can define different creatures, rewards and skills.",
      "rewardCount": 1,
      "rewardsByClass": {
        "adventurer": "practice_blade",
        "scholar": "practice_staff"
      }
    },
    {
      "id": "gather_herbs",
      "title": "A useful handful",
      "giver": "guide",
      "turnIn": "guide",
      "kind": "gather",
      "target": "herb",
      "count": 2,
      "xp": 80,
      "gold": 5,
      "minLevel": 2,
      "requires": [
        "first_steps"
      ],
      "text": "Gather from two different herb patches in the western meadow. Walk close and click a patch.",
      "objective": "Gather herbs from two patches",
      "complete": "Thank you! You have tried exploration, combat and gathering. This small world is yours to extend.",
      "rewardCount": 1
    },
    {
      "id": "willow_welcome",
      "title": "A welcome under the willows",
      "giver": "guide",
      "turnIn": "herbalist",
      "kind": "explore",
      "target": "herbalist-arrival",
      "count": 1,
      "xp": 20,
      "gold": 2,
      "minLevel": 1,
      "requires": [
        "first_steps"
      ],
      "location": {
        "x": -44,
        "z": -8
      },
      "radius": 5,
      "text": "Follow the western path to Willow rest. Willow Tender can show you the herb clearing; Reedwater Hollows lie just south of camp.",
      "objective": "Visit Willow rest",
      "complete": "Welcome to Willow rest. Herbs grow beyond the trees to the northwest. The reed pools south of the commons are a quiet place to explore.",
      "rewardCount": 1
    },
    {
      "id": "ridge_hello",
      "title": "News for Ridgewatch",
      "giver": "herbalist",
      "turnIn": "warden",
      "kind": "explore",
      "target": "warden-arrival",
      "count": 1,
      "xp": 20,
      "gold": 2,
      "minLevel": 1,
      "requires": [
        "willow_welcome"
      ],
      "location": {
        "x": 28,
        "z": -46
      },
      "radius": 5,
      "text": "Take the hillside trail northeast to Ridgewatch camp. Say hello to the warden; there is no parcel to carry and no hurry.",
      "objective": "Visit Ridgewatch camp",
      "complete": "Good to see a neighbor. The cairns ahead mark our practice grounds. The chalk quarry below to the southeast has more slimes and an abandoned work yard.",
      "rewardCount": 1
    }
  ],
