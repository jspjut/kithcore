  "readables": [
    {
      "id": "meadow-guidebook",
      "storyId": "meadow-guidebook",
      "title": "Welcome to the meadow",
      "author": "The camp guide",
      "x": 5,
      "z": 12,
      "pages": [
        {
          "heading": "A small adventure",
          "text": "Speak to Guide for quests. Visit Supplier for tonics and a larger bag. Keeper stores your spare items. The mailbox sends letters and items to other characters."
        },
        {
          "heading": "Make it your own",
          "text": "Humans and Harefolk can train as Adventurers or Scholars. Change your appearance on the character screen, bind your abilities, and adjust controls from the game menu."
        },
        {
          "heading": "Five corners of the vale",
          "text": "Meadow Commons is home. West lies Willow Grove, north is Sunrise Ridge, east is the Old Chalk Quarry and south are Reedwater Hollows. Paths connect three rest stops. Ask Guide about Willow rest after your first steps; Willow Tender will point you toward Ridgewatch."
        }
      ]
    }
  ]
